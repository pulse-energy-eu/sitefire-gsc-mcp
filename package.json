{
  "name": "@sitefire/sitefire-gsc-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for Google Search Console insights in Claude Desktop",
  "type": "module",
  "bin": {
    "sitefire-gsc-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION=1 vitest run",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "googleapis": "^148.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pulse-energy-eu/sitefire-gsc-mcp"
  },
  "keywords": [
    "mcp",
    "google-search-console",
    "seo",
    "geo",
    "claude"
  ]
}
